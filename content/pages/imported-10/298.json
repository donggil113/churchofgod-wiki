  "body": "<div class=\"mw-content-ltr mw-parser-output\" dir=\"ltr\" lang=\"ko\"><ul><li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%99%9C_%EC%95%88%EC%83%81%ED%99%8D%EB%8B%98%EC%9D%84_%EB%AF%BF%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 왜 안상홍님을 믿나요\">틀:질의응답/하나님의 교회는 왜 안상홍님을 믿나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EB%B6%80%ED%99%9C%EC%A0%88%EC%9D%84_%EC%96%B4%EB%96%BB%EA%B2%8C_%EC%A7%80%ED%82%A4%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 부활절을 어떻게 지키나요\">틀:질의응답/하나님의 교회는 부활절을 어떻게 지키나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%99%9C_%ED%81%AC%EB%A6%AC%EC%8A%A4%EB%A7%88%EC%8A%A4%EB%A5%BC_%EC%A7%80%ED%82%A4%EC%A7%80_%EC%95%8A%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 왜 크리스마스를 지키지 않나요\">틀:질의응답/하나님의 교회는 왜 크리스마스를 지키지 않나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C_%EC%97%AC%EC%84%B1%EB%8F%84%EB%8A%94_%EC%99%9C_%EC%98%88%EB%B0%B0_%EC%8B%9C_%EB%A8%B8%EB%A6%AC_%EC%88%98%EA%B1%B4%EC%9D%84_%EC%93%B0%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회 여성도는 왜 예배 시 머리 수건을 쓰나요\">틀:질의응답/하나님의 교회 여성도는 왜 예배 시 머리 수건을 쓰나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%99%9C_%EC%96%B4%EB%A8%B8%EB%8B%88_%ED%95%98%EB%82%98%EB%8B%98%EC%9D%84_%EB%AF%BF%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 왜 어머니 하나님을 믿나요\">틀:질의응답/하나님의 교회는 왜 어머니 하나님을 믿나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%99%9C_%ED%86%A0%EC%9A%94%EC%9D%BC%EC%97%90_%EC%98%88%EB%B0%B0%EB%A5%BC_%EB%93%9C%EB%A6%AC%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 왜 토요일에 예배를 드리나요\">틀:질의응답/하나님의 교회는 왜 토요일에 예배를 드리나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%99%9C_%EC%9C%A0%EC%9B%94%EC%A0%88%EC%9D%84_%EC%A7%80%ED%82%A4%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 왜 유월절을 지키나요\">틀:질의응답/하나님의 교회는 왜 유월절을 지키나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%99%9C_%EC%8B%AD%EC%9E%90%EA%B0%80%EB%A5%BC_%EC%84%B8%EC%9A%B0%EC%A7%80_%EC%95%8A%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 왜 십자가를 세우지 않나요\">틀:질의응답/하나님의 교회는 왜 십자가를 세우지 않나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%98%A4%EC%88%9C%EC%A0%88%EC%9D%84_%EC%A7%80%ED%82%A4%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 오순절을 지키나요\">틀:질의응답/하나님의 교회는 오순절을 지키나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%84%B1%EC%82%BC%EC%9C%84%EC%9D%BC%EC%B2%B4%EB%A5%BC_%EB%AF%BF%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 성삼위일체를 믿나요\">틀:질의응답/하나님의 교회는 성삼위일체를 믿나요</a></li>\n<li><a class=\"mw-redirect\" href=\"/%ED%8B%80:%EC%A7%88%EC%9D%98%EC%9D%91%EB%8B%B5/%ED%95%98%EB%82%98%EB%8B%98%EC%9D%98_%EA%B5%90%ED%9A%8C%EB%8A%94_%EC%96%B4%EB%94%94%EC%97%90_%EC%9E%88%EB%82%98%EC%9A%94\" title=\"틀:질의응답/하나님의 교회는 어디에 있나요\">틀:질의응답/하나님의 교회는 어디에 있나요</a></li></ul>\n<p><br/>\n</p><p><br/>\n</p><p><br/>\n</p>\n<!-- \nNewPP limit report\nCached time: 20260920115721\nCache expiry: 86400\nReduced expiry: false\nComplications: []\nCPU time usage: 0.006 seconds\nReal time usage: 0.008 seconds\nPreprocessor visited node count: 24/1000000\nPost‐expand include size: 211/2097152